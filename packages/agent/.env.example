# Wallet the sender granted with setGrant. Holds gas only, never USDT.
AGENT_PRIVATE_KEY=
# Whose vault balance the agent pays from.
SENDER_ADDRESS=
# Temporary inbox file, until the Arkiv source lands.
BILLS_FILE=bills.json
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# Comma-separated, tried in order. Groq rate limits are per organization, so a second
# key from the same organization covers a revoked key, not a rate limit.
GROQ_API_KEYS=
