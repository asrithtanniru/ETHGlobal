    "read-bills": "node --env-file-if-exists=.env scripts/read-bills.ts"
  },
  "dependencies": {
    "@arkiv-network/sdk": "^1.0.1",
    "@ghar/ens": "*",
    "@ghar/shared": "*",
    "viem": "^2.57.16"
