# Free key from https://hub.arkiv.network/access-keys. Server-side only.
ARKIV_ACCESS_KEY=
# Optional RPC overrides.
NEXT_PUBLIC_WHITECHAIN_RPC_URL=
NEXT_PUBLIC_SEPOLIA_RPC_URL=

# ---- Chat assistant ----
# Comma-separated Groq keys, tried in order. Empty turns the chat off.
GROQ_API_KEYS=
# Wallet that calls pay() when the sender approves a bill in chat. Grant it on the Agent page and fund it
# with WBT. It can be the background agent's key, but a separate one can be capped and revoked on its own.
CHAT_AGENT_PRIVATE_KEY=
# Wallet that writes the encrypted chat history to Arkiv. Fund it with test GLM at https://hub.arkiv.network/faucet
CHAT_ARKIV_PRIVATE_KEY=
# At least 32 random characters. Chat bodies on Arkiv are sealed with keys derived from it, so changing it
# makes old history unreadable. Generate one with: openssl rand -hex 32
CHAT_SECRET=
# Writes stay off unless this is 1. Most one write may cost, in wei.
ARKIV_ALLOW_WRITE=1
ARKIV_MAX_FEE_WEI=10000000000000000

# ---- Gasless deposits (needs the vault with depositWithAuthorization) ----
# Wallet that submits signed USDT deposits and pays their WBT gas. Fund it at https://faucet.testnet.whitechain.io
RELAYER_PRIVATE_KEY=
# Relays per hour across all wallets (each wallet also gets 3 an hour), and the highest gas price the relayer pays.
RELAY_HOURLY_LIMIT=60
RELAY_MAX_GAS_PRICE_GWEI=50

# ---- Pay with Direct (send money from the vault to a friend's card or bank) ----
# The vault's provider: markPaid / refund and Arkiv receipts. Demo convenience: in production the provider runs
# this on its own infrastructure.
PROVIDER_PRIVATE_KEY=
TRANSAK_API_KEY=
TRANSAK_API_SECRET=
TRANSAK_SELL_ETH=0.02
# Pays Transak's Sepolia ETH deposit address (the provider's float).
SEPOLIA_PRIVATE_KEY=
# Ghar's direct biller: the ghar.biller of direct.<family>.eth in ENS. Raises a send-bill only when a sender asks.
# Fund it with test GLM. Uses CHAT_SECRET and CHAT_AGENT_PRIVATE_KEY above too.
DIRECT_BILLER_PRIVATE_KEY=
