# ---- Arkiv ----
ARKIV_ACCESS_KEY=

# ---- Agent (npm run agent) ----
# Wallet the sender granted with setGrant. Needs WBT for gas on Whitechain Sepolia.
AGENT_PRIVATE_KEY=
# The sender whose vault balance pays the bills.
SENDER_ADDRESS=
# Comma-separated payee tags under gharfam.eth.
PAYEE_TAGS=rent
POLL_SECONDS=30
# Comma-separated, tried in order. Groq rate limits are per organization, so a second key from
# the same organization covers a revoked key, not a rate limit. Empty turns the AI review off.
GROQ_API_KEYS=
# Comma-separated invoice refs the sender approved after an AI hold.
APPROVED_INVOICES=

# ---- Settler (npm run settler) ----
# Must be the vault's immutable provider wallet. Needs WBT, and test GLM on Rabdi for receipts.
PROVIDER_PRIVATE_KEY=
ARKIV_ALLOW_WRITE=0
ARKIV_MAX_FEE_WEI=10000000000000000

# Transak staging (see ghar-payout-spike/INTEGRATION.md)
TRANSAK_API_KEY=
TRANSAK_API_SECRET=
TRANSAK_SELL_ETH=0.02
TRANSAK_EMAIL=
SEPOLIA_PRIVATE_KEY=
