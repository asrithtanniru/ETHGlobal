# ---- Arkiv ----
ARKIV_ACCESS_KEY=

# ---- Agent (npm run agent) ----
# Wallet the sender granted with setGrant. Needs WBT for gas on Whitechain Sepolia.
AGENT_PRIVATE_KEY=
# The sender whose vault balance pays the bills.
SENDER_ADDRESS=
# The sender's family name. Empty means gharfam.eth.
PAYEE_FAMILY=
# Comma-separated payee tags under that family.
PAYEE_TAGS=rent
POLL_SECONDS=30
# Comma-separated, tried in order. Groq rate limits are per organization, so a second key from
# the same organization covers a revoked key, not a rate limit. Empty turns the AI review off.
GROQ_API_KEYS=
# Comma-separated bill digests the sender approved after an AI hold. The agent logs the digest with each
# hold and keeps holds in .agent-holds, so they survive restarts. Restart the agent after editing this.
APPROVED_DIGESTS=

# ---- Settler (npm run settler) ----
# Must be the vault's immutable provider wallet. Needs WBT, and test GLM on Rabdi for receipts.
PROVIDER_PRIVATE_KEY=
ARKIV_ALLOW_WRITE=0
ARKIV_MAX_FEE_WEI=10000000000000000

# Transak staging (see ghar-payout-spike/INTEGRATION.md)
TRANSAK_API_KEY=
TRANSAK_API_SECRET=
TRANSAK_SELL_ETH=0.02
TRANSAK_EMAIL=
SEPOLIA_PRIVATE_KEY=
# INR sends pay out to the friend's UPI ID through P2P.me on Base Sepolia, from the same SEPOLIA_PRIVATE_KEY
# wallet: it needs Base Sepolia ETH for gas and P2P.me's test USDC as the float. Defaults are the live testnet.
P2P_DIAMOND_ADDRESS=0xeb0BB8E3c014D915D9B2df03aBB130a1Fb44beb9
P2P_USDC_ADDRESS=0x4095fE4f1E636f11A95820BA2bB87F335Bd1040d
P2P_SUBGRAPH_URL=https://api.studio.thegraph.com/query/1745491/event-indexer/version/latest
BASE_SEPOLIA_RPC_URL=https://base-sepolia-rpc.publicnode.com
