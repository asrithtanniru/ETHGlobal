# Whitechain Sepolia
RPC_URL=https://rpc.testnet.whitechain.io
GHAR_VAULT_ADDRESS=0xa855e5b5152f7c7c824dc5c8ef034696a65587ae
OPERATOR_PRIVATE_KEY=0x...           # must be the vault's provider key; the adapter refuses to start otherwise. Needs WBT for gas

# ENS payee book. The vault only emits a namehash, so list the tags to expect.
PAYEE_BOOK_PARENT=gharfam.eth
PAYEE_TAGS=rent

# Onramp.money white-label sandbox. Leave empty to run in MOCK mode.
ONRAMP_BASE_URL=https://api-test.onramp.money
ONRAMP_API_KEY=
ONRAMP_API_SECRET=

# 1 = force the next payouts to fail at the provider, to demo the refund path
SIMULATE_FAILURE=0

# ---- Provider choice: onramp (default) or transak ----
PROVIDER=onramp

# Transak staging (dashboard.transak.com -> Staging -> Developers)
TRANSAK_API_KEY=
TRANSAK_API_SECRET=
TRANSAK_SELL_ETH=0.02               # Sepolia ETH sold per payout
TRANSAK_EMAIL=                      # optional; you+failed@gmail.com forces FAILED -> refund on Whitechain
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
SEPOLIA_PRIVATE_KEY=0x...           # wallet holding Sepolia ETH for deposits (defaults to OPERATOR_PRIVATE_KEY)
USER_IP=                            # optional; auto-detected
